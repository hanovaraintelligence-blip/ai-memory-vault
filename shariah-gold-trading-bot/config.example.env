# Copy to .env (or export these as real environment variables) and fill in.
# Never commit real API keys.

# Exchange id as recognized by ccxt, e.g. binance, kraken, bitstamp.
# Use a spot-only / "Islamic" swap-free account if your exchange offers one.
EXCHANGE_ID=binance

# API credentials — grant SPOT TRADING permission only. Do NOT enable margin,
# futures, or withdrawal permissions on this key.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Spot pair to trade. Use a spot-settled gold instrument your exchange lists,
# e.g. PAXG/USDT or XAUT/USDT (tokenized gold), not a gold CFD or future.
SYMBOL=PAXG/USDT

# Candle timeframe used to compute the moving averages.
TIMEFRAME=1h

# SMA crossover windows, in number of candles.
SHORT_WINDOW=10
LONG_WINDOW=30

# Quote currency (e.g. USDT) spent per BUY signal.
QUOTE_AMOUNT_PER_BUY=50

# Seconds between signal checks in the continuous loop.
POLL_INTERVAL_SECONDS=300

# true = simulate signals and orders without sending anything to the exchange.
# Set to false only once you have reviewed the strategy and trust the config.
DRY_RUN=true
