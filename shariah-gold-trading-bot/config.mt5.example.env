# MT5 edition config. Copy to .env.mt5 and fill in.
#
# Unlike bot.py, this script does NOT log in with credentials — it attaches
# to an MT5 terminal that is already running and already logged into your
# (demo or live) account, with Tools > Options > Expert Advisors >
# "Allow algorithmic trading" enabled. See README.md for the full walkthrough.

# Symbol as listed in your broker's Market Watch. Most brokers' "XAUUSD" is a
# CFD, not spot gold — read the warning at the top of mt5_bot.py before
# using this beyond a demo account.
MT5_SYMBOL=XAUUSD

# One of M1, M5, M15, M30, H1, H4, D1
MT5_TIMEFRAME=H1

# SMA crossover windows, in number of candles.
SHORT_WINDOW=10
LONG_WINDOW=30

# Position size in lots (1.00 = 100,000 units of the base currency; check
# your broker's contract size for XAUUSD, often 100 oz per lot).
# Start small on a demo account.
MT5_VOLUME=0.01

# Arbitrary integer tag used to identify this bot's own orders/positions,
# so it never touches positions you opened by hand or with another EA.
MT5_MAGIC=20260903

# Seconds between signal checks in the continuous loop.
POLL_INTERVAL_SECONDS=300

# true = compute and log signals without sending any order to MT5.
# Set to false only once you have reviewed the strategy, confirmed the
# symbol is genuinely swap-free, and accept the risks.
DRY_RUN=true
